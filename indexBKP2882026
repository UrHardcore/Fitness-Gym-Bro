  function openGlobalAnalyticsModal(rangeType) {
    closeModal('calendarPromptModal');
    document.getElementById('globalAnalyticsModal').classList.add('active');
    
    const titleText = rangeType === '4weeks' ? 'Tendencias (Últimas 4 semanas)' : 'Tendencias (Historial completo)';
    document.getElementById('globalAnalyticsTitle').textContent = titleText;
    
    let totalLogs = 0;
    let positiveCount = 0;
    let anomalyCount = 0;
    let tableRowsHtml = '';

    for(let ex in historyData) {
      let records = historyData[ex] || [];
      if(rangeType === '4weeks' && records.length > 4) {
        records = records.slice(-4);
      }

      records.forEach((rec, idx) => {
        totalLogs++;
        let tagHtml = '<span style="color: var(--text-muted);">Estable ⚡</span>';
        if(idx > 0) {
          const prevKg = records[idx - 1].kg;
          if(rec.kg > prevKg) {
            positiveCount++;
            tagHtml = '<span style="color: #4E9F3D; font-weight:700;">🟢 Subida / Mejora (+PR)</span>';
          } else if(rec.kg < prevKg) {
            anomalyCount++;
            tagHtml = '<span style="color: #D93829; font-weight:700;">⚠️ Bajada / Anomalía</span>';
          }
        } else {
          tagHtml = '<span style="color: var(--text-muted);">🏁 Base inicial</span>';
        }

        tableRowsHtml += `
          <tr>
            <td>${rec.date}</td>
            <td><strong>${ex}</strong></td>
            <td>${rec.kg} kg</td>
            <td>${rec.reps}</td>
            <td>${tagHtml}</td>
          </tr>
        `;
      });
    }

    const container = document.getElementById('globalAnalyticsBody');
    if(totalLogs === 0) {
      container.innerHTML = `<div style="font-size: 13px; color: var(--text-muted); text-align: center; padding: 20px 0;">No hay registros de cargas suficientes para mostrar tendencias ni anomalías todavía. ¡Registrá tus series en los entrenamientos!</div>`;
      return;
    }

    container.innerHTML = `
      <div class="trend-metrics" style="margin-bottom: 14px;">
        <div class="trend-box">
          <div class="trend-label">Registros</div>
          <div class="trend-value">${totalLogs}</div>
        </div>
        <div class="trend-box">
          <div class="trend-label">Progresos</div>
          <div class="trend-value" style="color: #4E9F3D;">+${positiveCount}</div>
        </div>
        <div class="trend-box">
          <div class="trend-label">Anomalías/Bajas</div>
          <div class="trend-value" style="color: #D93829;">${anomalyCount}</div>
        </div>
      </div>
      <div style="font-size: 12px; font-weight: 700; margin-bottom: 6px; color: var(--text);">📋 Resumen de rendimiento global y detección de anomalías:</div>
      <div style="max-height: 280px; overflow-y: auto;">
        <table class="data-table">
          <thead>
            <tr>
