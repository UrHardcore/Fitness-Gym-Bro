  document.getElementById('logoutBtn').addEventListener('click', () => {
    if(currentUser) clearLocalCache(currentUser.uid);
    auth.signOut();
  });

  // Arranque instantáneo: si hay un respaldo local de la última sesión, lo pintamos
  // de inmediato sin esperar a que Firebase confirme la sesión por red.
  (function bootFromLocalCache(){
    try {
      const lastUid = localStorage.getItem(LAST_UID_KEY);
      if(!lastUid) return;
      const cached = loadLocalCache(lastUid);
      if(!cached || !cached.customRoutine) return; // sin respaldo útil, esperamos la confirmación normal

      userName = cached.userName || '';
      BASE_DAYS = cached.customRoutine || DEFAULT_DAYS;
      const weekData = (cached.weeks && cached.weeks[weekId]) || {};
      dayState = weekData.days || {};
      exState = weekData.exercises || {};
      extra = cached.extra || {};
      historyData = cached.historyData || {};
      streak = cached.streak || 0;
      BASE_DAYS.forEach(d => { if(!(d.id in dayState)) dayState[d.id] = false; if(!(d.id in exState)) exState[d.id] = {}; });

      document.getElementById('authScreen').style.display = 'none';
      document.getElementById('appCard').style.display = 'block';
      render();
    } catch(e) { console.error('No se pudo pintar desde el caché local', e); }
  })();

  auth.onAuthStateChanged(async (user) => {
    if(user) {
      currentUser = user;
      document.getElementById('authScreen').style.display = 'none';
      document.getElementById('appCard').style.display = 'block';
      await loadState();
      if(needsOnboarding) {
        runOnboarding(!!userName); // si ya sabemos el nombre (ej: recién registrado), saltamos ese paso
      } else {
        render();
      }
    } else {
      currentUser = null;
      document.getElementById('appCard').style.display = 'none';
      document.getElementById('authScreen').style.display = 'flex';
      document.getElementById('authLoadingView').style.display = 'none';
      document.getElementById('authFormView').style.display = 'block';
    }
  });
</script>
</body>
</html>
