  function isCardioExercise(exName) {
    const lower = exName.toLowerCase();
    return lower.includes('cinta') || lower.includes('caminata');
  }

  function playSuccessSound() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = 'sine';
      osc.frequency.setValueAtTime(523.25, ctx.currentTime);
      osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.3);
      gain.gain.setValueAtTime(0.1, ctx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
      osc.connect(gain); gain.connect(ctx.destination);
      osc.start(); osc.stop(ctx.currentTime + 0.3);
    } catch(e){}
  }

  function playRonnieColemanAudio() {
    const audio = new Audio("https://www.myinstants.com/media/sounds/yeah-buddy-lightweight.mp3");
    audio.play().catch(() => {
      if ('speechSynthesis' in window) {
        const msg = new SpeechSynthesisUtterance("Yeah Buddy! Light Weight Baby!");
        msg.pitch = 0.8;
        msg.rate = 1.1;
        msg.lang = 'en-US';
        window.speechSynthesis.speak(msg);
      }
    });
  }

  function triggerConfetti() {
    if(window.confetti) confetti({ particleCount: 90, spread: 70, origin: { y: 0.6 } });
  }

  function startTimer(sec) {
    clearInterval(timerInterval);
    timerSeconds = sec;
    updateTimerDisplay();
    timerInterval = setInterval(() => {
      timerSeconds--;
      updateTimerDisplay();
      if(timerSeconds <= 0) { clearInterval(timerInterval); playSuccessSound(); }
    }, 1000);
  }

  function resetTimer() { clearInterval(timerInterval); timerSeconds = 0; updateTimerDisplay(); }
  function updateTimerDisplay() {
    const m = String(Math.floor(timerSeconds / 60)).padStart(2, '0');
    const s = String(timerSeconds % 60).padStart(2, '0');
    document.getElementById('timerDisplay').textContent = `${m}:${s}`;
  }

  function userDocRef() { return db.collection('users').doc(currentUser.uid); }

  /* ===== NOMBRE DE USUARIO ÚNICO =====
     Se guarda una colección aparte "usernames/{nombre_normalizado}" que reserva
     cada nombre y apunta al uid del dueño, para poder chequear disponibilidad
     sin tener que leer los documentos de otros usuarios. */
  function normalizeUsername(name) { return name.trim().toLowerCase(); }

  async function isUsernameTaken(normalized, excludeUid) {
    const doc = await db.collection('usernames').doc(normalized).get();
    if(!doc.exists) return false;
    return doc.data().uid !== excludeUid;
  }

  async function claimUsername(normalized, displayName, uid) {
    await db.collection('usernames').doc(normalized).set({ uid: uid, displayName: displayName });
  }

  // Migra datos que hayan quedado guardados en este dispositivo (de cuando la app
  // todavía no tenía login) hacia el documento de Firestore del usuario, una sola vez.
  async function migrateLocalDataIfNeeded(docSnap) {
    try {
      if(docSnap.exists) return;
      const localName = localStorage.getItem(userNameKey);
      if(!localName) return;
      const localRoutine = JSON.parse(localStorage.getItem(customRoutineKey) || 'null');
      const localWeek = JSON.parse(localStorage.getItem(weekKey) || '{}');
      const localExtra = JSON.parse(localStorage.getItem(extraKey) || '{}');
      const localHistory = JSON.parse(localStorage.getItem(historyKey) || '{}');
      const localStreak = parseInt(localStorage.getItem(streakKey) || '0', 10);
      await userDocRef().set({
        userName: localName,
        customRoutine: localRoutine || DEFAULT_DAYS,
        extra: localExtra,
        historyData: localHistory,
        streak: localStreak,
        weeks: { [weekId]: { days: localWeek.days || {}, exercises: localWeek.exercises || {} } }
      }, { merge: true });
    } catch(e) { console.error('Migración local→nube falló', e); }
  }

  async function loadState(){
    userName = ''; BASE_DAYS = DEFAULT_DAYS; dayState = {}; exState = {}; extra = {}; historyData = {}; streak = 0; needsOnboarding = true;
    if(!currentUser) return;

    const cached = loadLocalCache(currentUser.uid);

    try {
      const docSnap = await userDocRef().get();
      await migrateLocalDataIfNeeded(docSnap);
      const snap = docSnap.exists ? docSnap : await userDocRef().get();
      const data = snap.exists ? snap.data() : {};

      userName = data.userName || '';
      needsOnboarding = !data.customRoutine;
      BASE_DAYS = data.customRoutine || DEFAULT_DAYS;
      const weekData = (data.weeks && data.weeks[weekId]) || {};
      dayState = weekData.days || {};
      exState = weekData.exercises || {};
      extra = data.extra || {};
      historyData = data.historyData || {};
      streak = data.streak || 0;
    } catch(e) {
      // Sin conexión con Firestore: usamos el último respaldo guardado en este dispositivo
      console.error('Error cargando datos de Firestore, usando caché local', e);
      if(cached) {
        userName = cached.userName || '';
        needsOnboarding = !cached.customRoutine;
        BASE_DAYS = cached.customRoutine || DEFAULT_DAYS;
        const weekData = (cached.weeks && cached.weeks[weekId]) || {};
        dayState = weekData.days || {};
        exState = weekData.exercises || {};
        extra = cached.extra || {};
        historyData = cached.historyData || {};
        streak = cached.streak || 0;
      } else {
        BASE_DAYS = DEFAULT_DAYS;
        needsOnboarding = true;
      }
    }

    // Si venimos de un registro recién hecho, no hace falta esperar la ida y vuelta a Firestore para el nombre
    if(!userName && pendingRegisterName) {
      userName = pendingRegisterName;
      saveUserName();
    }
    pendingRegisterName = '';

    BASE_DAYS.forEach(d => {
      if(!(d.id in dayState)) dayState[d.id] = false;
      if(!(d.id in exState)) exState[d.id] = {};
    });

    writeLocalCache();
  }

  function saveWeekState(){ if(!currentUser) return; writeLocalCache(); userDocRef().set({ weeks: { [weekId]: { days: dayState, exercises: exState } } }, { merge: true }).catch(e => console.error(e)); }
  function saveExtra(){ if(!currentUser) return; writeLocalCache(); userDocRef().set({ extra: extra }, { merge: true }).catch(e => console.error(e)); }
  function saveHistory(){ if(!currentUser) return; writeLocalCache(); userDocRef().set({ historyData: historyData }, { merge: true }).catch(e => console.error(e)); }
  function saveStreak(){ if(!currentUser) return; writeLocalCache(); userDocRef().set({ streak: streak }, { merge: true }).catch(e => console.error(e)); }
  function saveRoutine(){ if(!currentUser) return; writeLocalCache(); userDocRef().set({ customRoutine: BASE_DAYS }, { merge: true }).catch(e => console.error(e)); }
  function saveUserName(){ if(!currentUser) return; writeLocalCache(); userDocRef().set({ userName: userName }, { merge: true }).catch(e => console.error(e)); }

  function fullExercises(d){ return (d.exercises || []).concat(extra[d.id] || []); }

  function buildExerciseList(d, editable){
    const ul = document.createElement('ul');
    ul.className = 'ex-list';
    
    fullExercises(d).forEach(ex => {
      if(!exState[d.id]) exState[d.id] = {};
      if(!exState[d.id][ex]) {
        exState[d.id][ex] = { checked: false, sets: [{ kg: '', reps: '' }] };
      }
      
      const exData = exState[d.id][ex];
      if(!exData.sets) exData.sets = [{ kg: '', reps: '' }];

      const checked = !!exData.checked;
      const isCardio = isCardioExercise(ex);

      const li = document.createElement('li');
      li.className = 'ex-item' + (checked ? ' checked' : '');

      const topDiv = document.createElement('div');
      topDiv.className = 'ex-item-top';

      const mainClick = document.createElement('div');
      mainClick.className = 'ex-main-click';
      mainClick.innerHTML = `
        <div class="ex-check">
          <svg width="10" height="8" viewBox="0 0 10 8" fill="none">
            <path d="M1 4L3.5 6.5L9 1" stroke="#0E0E10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="ex-name">${ex}</span>
      `;
      mainClick.addEventListener('click', () => toggleExercise(d.id, ex));

      const toolsWrap = document.createElement('div');
      toolsWrap.className = 'ex-tools';

      const scienceBtn = document.createElement('button');
      scienceBtn.className = 'action-icon-btn';
      scienceBtn.innerHTML = `🧠`;
      scienceBtn.title = 'Ciencia y Biomecánica';
      scienceBtn.addEventListener('click', (e) => { e.stopPropagation(); openExerciseScienceModal(ex); });

      const demoBtn = document.createElement('a');
      demoBtn.className = 'action-icon-btn';
      demoBtn.innerHTML = `🎥`;
      demoBtn.title = 'Ver Técnica';
      demoBtn.target = '_blank';
      demoBtn.href = `https://www.youtube.com/results?search_query=tecnica+${encodeURIComponent(ex)}`;

      const chartBtn = document.createElement('button');
      chartBtn.className = 'action-icon-btn';
      chartBtn.innerHTML = `📈`;
      chartBtn.addEventListener('click', (e) => { e.stopPropagation(); openChartModal(ex); });

      toolsWrap.appendChild(scienceBtn);
      toolsWrap.appendChild(demoBtn);
      toolsWrap.appendChild(chartBtn);

      if (extra[d.id] && extra[d.id].includes(ex)) {
        const delBtn = document.createElement('button');
        delBtn.className = 'action-icon-btn';
        delBtn.innerHTML = `🗑️`;
        delBtn.addEventListener('click', (e) => { e.stopPropagation(); removeExercise(d.id, ex); });
        toolsWrap.appendChild(delBtn);
      }

      topDiv.appendChild(mainClick);
      topDiv.appendChild(toolsWrap);
      li.appendChild(topDiv);

      const setsContainer = document.createElement('div');
      setsContainer.className = 'sets-container';

      exData.sets.forEach((set, sIdx) => {
        const setRow = document.createElement('div');
        setRow.className = 'set-row';

        const label = document.createElement('span');
        label.className = 'set-label';
        label.textContent = `Serie ${sIdx + 1}`;

        const inputsDiv = document.createElement('div');
        inputsDiv.className = 'set-inputs';

        const kgInput = document.createElement('input');
        kgInput.type = 'number';
        kgInput.placeholder = isCardio ? 'km' : 'kg';
        kgInput.value = set.kg !== undefined ? set.kg : '';
        kgInput.addEventListener('change', (e) => {
          set.kg = e.target.value;
          saveWeekState();
          updateExHistory(ex, set.kg, set.reps);
        });

        const repsInput = document.createElement('input');
        repsInput.type = 'number';
        repsInput.placeholder = 'reps';
        repsInput.value = set.reps !== undefined ? set.reps : '';
        repsInput.addEventListener('change', (e) => {
          set.reps = e.target.value;
          saveWeekState();
          updateExHistory(ex, set.kg, set.reps);
        });

        inputsDiv.appendChild(kgInput);
        inputsDiv.appendChild(repsInput);

        const actionSlot = document.createElement('div');
        actionSlot.className = 'set-action-slot';

        if(exData.sets.length > 1) {
          const removeSetBtn = document.createElement('button');
          removeSetBtn.className = 'action-icon-btn';
          removeSetBtn.innerHTML = '✕';
          removeSetBtn.style.fontSize = '11px';
          removeSetBtn.title = 'Eliminar serie';
          removeSetBtn.addEventListener('click', () => {
            exData.sets.splice(sIdx, 1);
            saveWeekState();
            render();
          });
          actionSlot.appendChild(removeSetBtn);
        }

        setRow.appendChild(label);
        setRow.appendChild(inputsDiv);
        setRow.appendChild(actionSlot);
        setsContainer.appendChild(setRow);
      });

      const addSetBtn = document.createElement('button');
      addSetBtn.className = 'add-set-btn';
      addSetBtn.textContent = '+ Agregar Serie';
      addSetBtn.addEventListener('click', () => {
        exData.sets.push({ kg: '', reps: '' });
        saveWeekState();
        render();
      });

      setsContainer.appendChild(addSetBtn);
      li.appendChild(setsContainer);

      ul.appendChild(li);
    });

    if(!editable) return ul;

    const wrap = document.createDocumentFragment();
    wrap.appendChild(ul);

    const addSection = document.createElement('div');
    addSection.className = 'add-section';

    const customRow = document.createElement('div');
    customRow.className = 'custom-row';
    const input = document.createElement('input');
    input.type = 'text'; input.placeholder = 'Agregar ejercicio extra';
    const btn = document.createElement('button');
    btn.textContent = 'Agregar';

    const handleAdd = () => {
      const val = input.value.trim();
      if(val) addExercise(d.id, val);
    };

    btn.addEventListener('click', handleAdd);
    input.addEventListener('keydown', (e) => { if(e.key === 'Enter') handleAdd(); });

    customRow.appendChild(input); customRow.appendChild(btn);
    addSection.appendChild(customRow);
    wrap.appendChild(addSection);
    return wrap;
  }

  function updateExHistory(exName, kg, reps) {
    if(!historyData[exName]) historyData[exName] = [];
    if(kg && reps) {
      historyData[exName].push({ date: fmt(new Date()), kg: parseFloat(kg)||0, reps: parseInt(reps)||0 });
      saveHistory();
    }
  }

  function render(){
    document.getElementById('userGreeting').textContent = userName ? `Hola, ${userName} 👋` : 'Hola 👋';
    const todayEntry = BASE_DAYS.find(d => d.jsDay === todayJs);
    document.getElementById('weekLabel').textContent = `Semana del ${fmt(monday)} al ${fmt(sunday)}`;
    document.getElementById('streakCount').textContent = `${streak} días`;
    document.getElementById('quoteBox').textContent = MOTIVATIONAL_QUOTES[today.getDay() % MOTIVATIONAL_QUOTES.length];

    const headline = document.getElementById('headline');
    const subline = document.getElementById('subline');
    const routineCard = document.getElementById('routineCard');

    if(todayEntry){
      const done = dayState[todayEntry.id];
      headline.textContent = todayEntry.label;
      headline.classList.remove('rest');
      subline.innerHTML = done
        ? `<strong>Ya entrenaste hoy.</strong> ${todayEntry.group}, ¡gran trabajo!`
        : `Hoy toca <strong>${todayEntry.group.toLowerCase()}</strong>. Tildá al terminar.`;

      routineCard.style.display = 'block';
      routineCard.innerHTML = '';
      const title = document.createElement('div');
      title.className = 'rc-title';
      title.textContent = `Rutina de hoy · ${todayEntry.group}`;
      routineCard.appendChild(title);
      routineCard.appendChild(buildExerciseList(todayEntry, true));
    } else {
      headline.textContent = 'Descanso';
      headline.classList.add('rest');
      subline.textContent = 'Hoy no hay entrenamiento en tu calendario.';
      routineCard.style.display = 'none';
    }

    const barbell = document.getElementById('barbell');
    barbell.innerHTML = '';
    barbell.appendChild(makeBarSegment());
    BASE_DAYS.forEach(d => {
      barbell.appendChild(makePlate(d, todayEntry));
      barbell.appendChild(makeBarSegment());
    });

    const list = document.getElementById('list');
    list.innerHTML = '';
    BASE_DAYS.forEach(d => list.appendChild(makeRow(d, todayEntry)));

    const doneCount = BASE_DAYS.filter(d => dayState[d.id]).length;
    document.getElementById('progressText').textContent = `${doneCount}/${BASE_DAYS.length}`;
    document.getElementById('progressFill').style.width = `${(doneCount/BASE_DAYS.length)*100}%`;
  }

  function makeBarSegment(){ const seg = document.createElement('div'); seg.className = 'bar-line'; return seg; }

  function makePlate(d, todayEntry){
    const el = document.createElement('div');
    el.className = 'plate' + (dayState[d.id] ? ' done' : '') + (todayEntry && d.id === todayEntry.id ? ' today' : '');
    el.innerHTML = `<span class="letter">${d.short}</span><span class="dot"></span>`;
    el.addEventListener('click', () => toggleDay(d.id));
    return el;
  }

  function makeRow(d, todayEntry){
    const el = document.createElement('div');
    el.className = 'row' + (dayState[d.id] ? ' done' : '');

    const main = document.createElement('div');
    main.className = 'row-main';
    main.innerHTML = `
      <div class="row-left">
        <div class="checkbox">
          <svg width="12" height="10" viewBox="0 0 12 10" fill="none">
            <path d="M1 5L4.5 8.5L11 1" stroke="#0E0E10" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="row-text">
