<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0E0E10">

<!-- Configuración PWA & iOS / Android -->
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="LiftLog">

<!-- Íconos y Manifest -->
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="manifest" href="manifest.json">

<title>LiftLog</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

<!-- Firebase SDK (compat) -->
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.14.1/firebase-firestore-compat.js"></script>
<style>
  :root {
    --bg: #0E0E10;
    --surface: #18181B;
    --surface-2: #202024;
    --text: #EDEDEC;
    --text-muted: #8A8A8E;
    --accent: #C1443D;
    --accent-soft: rgba(193,68,61,0.16);
    --border: #2A2A2E;
    --card-shadow: rgba(0,0,0,0.5);
  }

  [data-theme="light"] {
    --bg: #F4F4F5;
    --surface: #FFFFFF;
    --surface-2: #E4E4E7;
    --text: #18181B;
    --text-muted: #71717A;
    --accent: #D93829;
    --accent-soft: rgba(217, 56, 41, 0.12);
    --border: #D4D4D8;
    --card-shadow: rgba(0,0,0,0.05);
  }

  *{ box-sizing: border-box; margin:0; padding:0; user-select:none; }

  html,body{
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    transition: background 0.3s ease, color 0.3s ease;
  }

  body{
    display:flex;
    justify-content:center;
    padding: 32px 18px 60px;
  }

  .card{ width:100%; max-width: 440px; position: relative; }

  .header-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }

  .eyebrow{ font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }

  .top-actions { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }

  .theme-toggle, .icon-nav-btn {
    background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
    padding: 4px 10px; border-radius: 20px; font-size: 12px; cursor: pointer; font-weight: 600;
    display: flex; align-items: center; gap: 4px;
  }

  .streak-badge {
    display: inline-flex; align-items: center; gap: 6px; background: var(--surface-2);
    border: 1px solid var(--border); padding: 4px 10px; border-radius: 12px;
    font-size: 12px; font-weight: 700; color: var(--accent); margin-bottom: 12px;
  }

  .headline{
    font-family: 'Anton', sans-serif; font-weight: 400; letter-spacing: 0.01em;
    font-size: clamp(40px, 12vw, 58px); line-height: 0.95; text-transform: uppercase; margin-bottom: 4px;
  }

  .headline.rest{ color: var(--text-muted); }

  .subline{ font-size: 14px; color: var(--text-muted); margin-bottom: 12px; }
  .subline strong{ color: var(--text); font-weight: 600; }

  .quote-box {
    font-size: 12px; font-style: italic; color: var(--text-muted);
    border-left: 2px solid var(--accent); padding-left: 8px; margin-bottom: 20px;
  }

  .timer-card {
    background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 16px; margin-bottom: 18px; display: flex; align-items: center; justify-content: space-between;
  }

  .timer-display { font-family: 'Anton', sans-serif; font-size: 24px; letter-spacing: 1px; color: var(--text); }
  .timer-btn-group { display: flex; gap: 6px; }

  .timer-btn {
    background: var(--surface-2); border: 1px solid var(--border); color: var(--text);
    padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;
  }

  .routine-card{
    background: var(--surface); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: 10px; padding: 16px 18px; margin-bottom: 24px; box-shadow: 0 4px 12px var(--card-shadow);
  }

  .routine-card .rc-title{
    font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent); font-weight: 700; margin-bottom: 10px;
  }

  .ex-list{ list-style:none; display:flex; flex-direction:column; gap: 10px; }

  .ex-item{
    display:flex; flex-direction: column;
    padding: 10px 12px; background: var(--surface-2);
    border: 1px solid var(--border); border-radius: 8px; gap: 8px;
  }

  .ex-item-top { display: flex; align-items: center; justify-content: space-between; width: 100%; }

  .ex-main-click{ display:flex; align-items:center; gap: 10px; flex:1; cursor:pointer; }

  .ex-check{
    width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--text-muted);
    flex-shrink:0; display:flex; align-items:center; justify-content:center;
  }

  .ex-item.checked .ex-check{ background: var(--accent); border-color: var(--accent); }
  .ex-check svg{ opacity:0; }
  .ex-item.checked .ex-check svg{ opacity:1; }

  .ex-name{ font-size: 13px; font-weight: 500; color: var(--text); }
  .ex-item.checked .ex-name{ color: var(--text-muted); text-decoration: line-through; }

  .sets-container { display: flex; flex-direction: column; gap: 6px; width: 100%; padding-left: 28px; }
  
  .set-row {
    display: grid;
    grid-template-columns: 65px 1fr 24px;
    align-items: center;
    gap: 8px;
    background: var(--bg); border: 1px solid var(--border); border-radius: 6px;
    padding: 6px 10px; font-size: 12px;
  }

  .set-label { font-weight: 700; color: var(--text-muted); text-transform: uppercase; font-size: 11px; }

  .set-inputs { 
    display: grid; 
    grid-template-columns: 1fr 1fr; 
    gap: 6px; 
    width: 100%;
  }
  .set-inputs input {
    width: 100%; background: var(--surface); border: 1px solid var(--border);
    border-radius: 4px; color: var(--text); font-size: 12px; padding: 4px; text-align: center;
  }

  .set-action-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .add-set-btn {
    background: var(--surface); border: 1px dashed var(--border); color: var(--text);
    width: 100%; padding: 6px; border-radius: 6px; font-size: 11px; font-weight: 600;
    cursor: pointer; text-align: center; margin-top: 4px; transition: border-color 0.2s;
  }
  .add-set-btn:hover { border-color: var(--accent); color: var(--accent); }

  .ex-tools { display: flex; align-items: center; gap: 4px; }

  .action-icon-btn {
    background: none; border: none; color: var(--text-muted);
    cursor: pointer; display: flex; align-items: center; justify-content: center; padding: 3px; font-size: 14px;
  }

  .add-section{ margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border); }
  .custom-row{ display:flex; gap: 8px; }

  .custom-row input{
    flex:1; background: var(--surface-2); border: 1px solid var(--border);
    border-radius: 8px; padding: 8px 12px; font-size: 13px; color: var(--text);
  }

  .custom-row button{
    background: var(--accent); color: #0E0E10; border:none;
    border-radius: 8px; padding: 0 14px; font-size: 13px; font-weight: 700; cursor:pointer;
  }

  .barbell{
    display:flex; align-items:center; gap: 0; margin: 8px 0 26px; padding: 16px 4px;
    background: var(--surface); border: 1px solid var(--border); border-radius: 14px; overflow-x: auto;
  }

  .bar-line{ flex:1; height: 4px; background: linear-gradient(90deg, var(--border), var(--text-muted), var(--border)); min-width: 6px; }

  .plate{
    width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--border);
    background: var(--surface-2); display:flex; align-items:center; justify-content:center;
    cursor:pointer; flex-shrink:0; position:relative;
  }

  .plate .letter{ font-family:'Anton', sans-serif; font-size: 15px; color: var(--text-muted); }
  .plate.done{ background: var(--accent); border-color: var(--accent); }
  .plate.done .letter{ color: #0E0E10; }
  .plate.today:not(.done){ border-color: var(--text); }

  .plate .dot{
    position:absolute; top:-2px; right:-2px; width:7px; height:7px;
    border-radius:50%; background: var(--accent); display:none;
  }
  .plate.today .dot{ display:block; }

  .list{ display:flex; flex-direction:column; gap: 8px; margin-bottom: 26px; }
  .row{ background: var(--surface); border: 1px solid var(--border); border-radius: 10px; overflow:hidden; }
  .row.done{ background: var(--accent-soft); border-color: var(--accent); }

  .row-main{ display:flex; align-items:center; justify-content:space-between; padding: 14px 16px; cursor:pointer; }
  .row-left{ display:flex; align-items:center; gap: 12px; }

  .checkbox{ width: 20px; height: 20px; border-radius: 5px; border: 2px solid var(--text-muted); display:flex; align-items:center; justify-content:center; }
  .row.done .checkbox{ background: var(--accent); border-color: var(--accent); }
  .checkbox svg{ opacity:0; }
  .row.done .checkbox svg{ opacity:1; }

  .row-text{ display:flex; flex-direction:column; gap:2px; }
  .row-label{ font-weight: 600; font-size: 15px; }
  .row-group{ font-size: 12px; color: var(--text-muted); }

  .row-right{ display:flex; align-items:center; gap: 12px; }
  .row-status{ font-size: 12px; color: var(--text-muted); font-weight: 500; text-transform: uppercase; }
  .row.done .row-status{ color: var(--accent); }

  .chevron{ width: 22px; height: 22px; display:flex; align-items:center; justify-content:center; color: var(--text-muted); transition: transform .2s ease; }
  .chevron.open{ transform: rotate(180deg); }

  .row-exercises{ max-height: 0; overflow:hidden; transition: max-height .3s ease; border-top: 1px solid transparent; }
  .row-exercises.open{ max-height: 1200px; border-top: 1px solid var(--border); }
  .row-exercises-inner{ padding: 14px 16px; }

  .progress-block{ display:flex; flex-direction:column; gap: 8px; }
  .progress-top{ display:flex; justify-content:space-between; font-size: 13px; color: var(--text-muted); }
  .progress-top strong{ color: var(--text); }

  .bar-track{ height: 6px; background: var(--surface-2); border-radius: 3px; overflow:hidden; border: 1px solid var(--border); }
  .bar-fill{ height: 100%; background: var(--accent); width: 0%; transition: width .4s ease; }

  .reset-link{ margin-top: 22px; text-align:center; }
  .reset-link button{ background:none; border:none; color: var(--text-muted); font-size: 12px; cursor:pointer; text-decoration: underline; }

  .footer-branding {
    margin-top: 32px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .footer-copy {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .footer-author {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
  }

  .ig-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    padding: 6px 12px;
    border-radius: 20px;
    color: var(--text);
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .ig-link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .ig-icon {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .modal-overlay {
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.8); display: none;
    align-items: center; justify-content: center; z-index: 100; padding: 16px;
  }
  .modal-overlay.active { display: flex; }

  .modal-card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 12px; width: 100%; max-width: 420px; padding: 20px;
    max-height: 85vh; overflow-y: auto; position: relative;
  }

  .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .modal-title { font-size: 16px; font-weight: 700; }
  
  .trend-metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 14px; }
  .trend-box { background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 8px; text-align: center; }
  .trend-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; margin-bottom: 2px; }
  .trend-value { font-size: 14px; font-weight: 700; color: var(--text); }

  .chart-container { width: 100%; height: 160px; position: relative; margin-bottom: 12px; }
  canvas { width: 100%!important; height: 100%!important; }

  .data-table { width: 100%; border-collapse: collapse; font-size: 11px; margin-top: 10px; }
  .data-table th, .data-table td { border: 1px solid var(--border); padding: 6px 8px; text-align: center; }
  .data-table th { background: var(--surface-2); color: var(--text-muted); font-weight: 700; text-transform: uppercase; }

  .wizard-step-title { font-size: 18px; font-weight: 700; color: var(--accent); margin-bottom: 4px; }
  .wizard-step-sub { font-size: 12px; color: var(--text-muted); margin-bottom: 14px; }
  .wizard-select {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    color: var(--text); padding: 8px; border-radius: 6px; margin-bottom: 14px; font-size: 13px;
  }
  .wizard-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
  .wizard-item {
    display: flex; align-items: center; gap: 10px; background: var(--surface-2);
    padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border); font-size: 13px; cursor: pointer;
  }
  .wizard-item input { accent-color: var(--accent); width: 16px; height: 16px; }
  .wizard-nav { display: flex; justify-content: space-between; gap: 8px; margin-top: 14px; }

  .train-overlay { text-align: center; padding: 20px 0; }
  .train-title {
    font-family: 'Anton', sans-serif; font-size: 48px; color: var(--accent);
    letter-spacing: 2px; margin-bottom: 10px; text-transform: uppercase;
  }

  .science-box { font-size: 12px; line-height: 1.5; color: var(--text); }
  .science-box h4 { color: var(--accent); margin-top: 10px; margin-bottom: 4px; font-size: 13px; }
  .science-box p { margin-bottom: 8px; }
  .science-box ul { margin-left: 16px; margin-bottom: 8px; }
  .science-source { font-size: 10px; color: var(--text-muted); font-style: italic; border-top: 1px solid var(--border); padding-top: 6px; margin-top: 10px; }

  /* ===== AUTH SCREEN ===== */
  #authScreen {
    position: fixed; inset: 0; background: var(--bg); z-index: 200;
    display: flex; align-items: center; justify-content: center; padding: 24px 18px;
  }
  .auth-card { width: 100%; max-width: 400px; }
  .auth-logo {
    font-family: 'Anton', sans-serif; font-size: 40px; text-transform: uppercase;
    text-align: center; margin-bottom: 4px; letter-spacing: 0.01em;
  }
  .auth-tagline { text-align: center; font-size: 12px; color: var(--text-muted); margin-bottom: 22px; }

  .auth-tabs {
    display: flex; background: var(--surface-2); border: 1px solid var(--border);
    border-radius: 10px; padding: 3px; margin-bottom: 18px;
  }
  .auth-tab {
    flex: 1; text-align: center; padding: 8px; font-size: 12px; font-weight: 700;
    color: var(--text-muted); border-radius: 8px; cursor: pointer; background: none; border: none;
  }
  .auth-tab.active { background: var(--accent); color: #0E0E10; }

  .auth-field { margin-bottom: 12px; }
  .auth-field label { display:block; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; margin-bottom: 6px; }
  .auth-field input {
    width: 100%; background: var(--surface-2); border: 1px solid var(--border);
    border-radius: 8px; padding: 10px 12px; font-size: 14px; color: var(--text);
  }
  .auth-field input:focus { outline: none; border-color: var(--accent); }

  .auth-forgot { text-align: right; margin: -4px 0 14px; }
  .auth-forgot button {
    background: none; border: none; color: var(--accent); font-size: 12px;
    font-weight: 600; cursor: pointer; padding: 0;
  }

  .auth-primary-btn {
    width: 100%; background: var(--accent); color: #0E0E10; border: none;
    border-radius: 8px; padding: 12px; font-size: 14px; font-weight: 700; cursor: pointer;
    margin-bottom: 14px; display:flex; align-items:center; justify-content:center; gap:8px;
  }
  .auth-primary-btn:disabled { opacity: 0.6; cursor: default; }

  .auth-divider { display: flex; align-items: center; gap: 10px; margin: 14px 0; }
  .auth-divider::before, .auth-divider::after { content:''; flex:1; height:1px; background: var(--border); }
  .auth-divider span { font-size: 11px; color: var(--text-muted); text-transform: uppercase; }

  .auth-google-btn {
    width: 100%; background: var(--surface); border: 1px solid var(--border); color: var(--text);
    border-radius: 8px; padding: 11px; font-size: 13px; font-weight: 600; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 10px;
  }

  .auth-error {
    background: var(--accent-soft); border: 1px solid var(--accent); color: var(--accent);
    font-size: 12px; padding: 8px 10px; border-radius: 8px; margin-bottom: 14px; display: none;
  }
  .auth-error.show { display: block; }

  .auth-info {
    background: var(--surface-2); border: 1px solid var(--border); color: var(--text-muted);
    font-size: 12px; padding: 8px 10px; border-radius: 8px; margin-bottom: 14px; display: none;
  }
  .auth-info.show { display: block; }

  .auth-loading { text-align: center; color: var(--text-muted); font-size: 13px; }

  .auth-spinner {
    width: 16px; height: 16px; border-radius: 50%;
    border: 2px solid rgba(14,14,16,0.3); border-top-color: #0E0E10;
    animation: auth-spin 0.7s linear infinite;
  }
  @keyframes auth-spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>

<!-- ===== PANTALLA DE LOGIN / REGISTRO ===== -->
<div id="authScreen">
  <div class="auth-card">
    <div id="authLoadingView" class="auth-loading">Cargando…</div>

    <div id="authFormView" style="display:none;">
      <div class="auth-logo">LiftLog</div>
      <div class="auth-tagline">Iniciá sesión para llevar tu progreso a cualquier dispositivo</div>

      <div class="auth-tabs">
        <button class="auth-tab active" id="authTabLogin" onclick="switchAuthTab('login')">Iniciar sesión</button>
        <button class="auth-tab" id="authTabRegister" onclick="switchAuthTab('register')">Registrarme</button>
      </div>

      <div class="auth-error" id="authError"></div>
      <div class="auth-info" id="authInfo"></div>

      <!-- LOGIN -->
      <form id="loginFormEl" onsubmit="return handleLoginSubmit(event)">
        <div class="auth-field">
          <label>Email</label>
          <input type="email" id="loginEmail" placeholder="tu@email.com" required autocomplete="email">
        </div>
        <div class="auth-field">
          <label>Contraseña</label>
          <input type="password" id="loginPassword" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <div class="auth-forgot">
          <button type="button" onclick="handleForgotPassword()">¿Olvidaste tu contraseña?</button>
        </div>
        <button type="submit" class="auth-primary-btn" id="loginSubmitBtn">Ingresar</button>
      </form>

      <!-- REGISTRO -->
      <form id="registerFormEl" style="display:none;" onsubmit="return handleRegisterSubmit(event)">
        <div class="auth-field">
          <label>Nombre</label>
          <input type="text" id="registerName" placeholder="Tu nombre" required autocomplete="name">
        </div>
        <div class="auth-field">
          <label>Email</label>
          <input type="email" id="registerEmail" placeholder="tu@email.com" required autocomplete="email">
        </div>
        <div class="auth-field">
          <label>Contraseña</label>
          <input type="password" id="registerPassword" placeholder="Mínimo 6 caracteres" required autocomplete="new-password" minlength="6">
        </div>
        <div class="auth-field">
          <label>Repetir contraseña</label>
          <input type="password" id="registerPassword2" placeholder="••••••••" required autocomplete="new-password" minlength="6">
        </div>
        <button type="submit" class="auth-primary-btn" id="registerSubmitBtn">Crear cuenta</button>
      </form>

      <div class="auth-divider"><span>o</span></div>

      <button type="button" class="auth-google-btn" id="googleSignInBtn" onclick="handleGoogleSignIn()">
