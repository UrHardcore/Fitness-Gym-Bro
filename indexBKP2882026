  const customRoutineKey = 'gym-custom-routine';
  const extraKey = 'gym-routine-extra';
  const historyKey = 'gym-routine-history';
  const streakKey = 'gym-routine-streak';
  const userNameKey = 'gym-user-name';

  const todayJs = today.getDay();

  let BASE_DAYS = [];
  let dayState = {}, exState = {}, extra = {}, historyData = {}, streak = 0, expanded = {};
  let timerInterval = null, timerSeconds = 0;
  let wizardStep = 0, tempRoutine = [], userName = '';
  let obStep = 0, tutorialStep = 0, isDirectTutorial = false;
  let needsOnboarding = true;

