  function openChartModal(exName) {
    document.getElementById('chartTitle').textContent = `Progresión: ${exName}`;
    document.getElementById('chartModal').classList.add('active');
    
    const data = historyData[exName] || [];
    const isCard = isCardioExercise(exName);
    const unitLabel = isCard ? 'km' : 'kg';

    const lastEl = document.getElementById('trendLast');
    const maxEl = document.getElementById('trendMax');
    const diffEl = document.getElementById('trendDiff');
    const tableContainer = document.getElementById('progressionTableContainer');

    if(data.length > 0) {
      const weights = data.map(d => d.kg);
      const lastVal = weights[weights.length - 1];
      const maxVal = Math.max(...weights);
      lastEl.textContent = `${lastVal} ${unitLabel}`;
      maxEl.textContent = `${maxVal} ${unitLabel}`;

      if(data.length >= 2) {
        const firstVal = weights[0];
        const change = +(lastVal - firstVal).toFixed(1);
        diffEl.textContent = (change >= 0 ? '+' : '') + change + ` ${unitLabel}`;
        diffEl.style.color = change >= 0 ? '#4E9F3D' : 'var(--accent)';
      } else {
        diffEl.textContent = 'Inicial';
        diffEl.style.color = 'var(--text-muted)';
      }

      let tableHtml = `
        <div style="font-size:12px; font-weight:700; margin:14px 0 6px; color:var(--text);">📋 Historial y Comparativas (Ranking / Anomalías)</div>
        <table class="data-table">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Carga</th>
              <th>Reps</th>
              <th>Análisis / Comparación</th>
            </tr>
          </thead>
          <tbody>
      `;

      data.forEach((item, idx) => {
        let statusTag = '<span style="color:var(--text-muted);">Estable ⚡</span>';
        if(idx > 0) {
          const prev = data[idx - 1].kg;
          if(item.kg > prev) statusTag = '<span style="color:#4E9F3D; font-weight:700;">📈 Subida (PR)</span>';
          else if(item.kg < prev) statusTag = '<span style="color:#D93829; font-weight:700;">⚠️ Baja (Anomalía)</span>';
        } else {
          statusTag = '<span style="color:var(--text-muted);">🏁 Base</span>';
        }

        tableHtml += `
          <tr>
            <td>${item.date}</td>
            <td><strong>${item.kg} ${unitLabel}</strong></td>
            <td>${item.reps}</td>
            <td>${statusTag}</td>
          </tr>
        `;
      });

      tableHtml += `</tbody></table>`;
      tableContainer.innerHTML = tableHtml;

    } else {
      lastEl.textContent = `-`;
      maxEl.textContent = `-`;
      diffEl.textContent = `-`;
      tableContainer.innerHTML = `<div style="font-size:12px; color:var(--text-muted); text-align:center; margin-top:10px;">Sin registros de cargas aún para este ejercicio.</div>`;
    }

    const canvas = document.getElementById('progressChart');
    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    canvas.width = canvas.offsetWidth; canvas.height = canvas.offsetHeight;

    if(data.length < 2) {
      ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--text-muted');
      ctx.font = '12px Inter';
      ctx.fillText('Registrá al menos 2 cargas para ver el gráfico', 20, canvas.height / 2);
      return;
    }

    const padding = 30;
    const weights = data.map(d => d.kg);
    const maxW = Math.max(...weights, 10); const minW = Math.min(...weights, 0);

    ctx.beginPath();
    ctx.strokeStyle = getComputedStyle(document.body).getPropertyValue('--accent');
    ctx.lineWidth = 2;

    data.forEach((pt, i) => {
      const x = padding + (i / (data.length - 1)) * (canvas.width - padding * 2);
      const y = canvas.height - padding - ((pt.kg - minW) / (maxW - minW || 1)) * (canvas.height - padding * 2);
      if(i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
      ctx.fillStyle = getComputedStyle(document.body).getPropertyValue('--accent');
      ctx.fillRect(x - 3, y - 3, 6, 6);
    });
    ctx.stroke();
  }

