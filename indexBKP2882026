    exWrap.className = 'row-exercises' + (expanded[d.id] ? ' open' : '');
    const inner = document.createElement('div');
    inner.className = 'row-exercises-inner';
    inner.appendChild(buildExerciseList(d, true));
    exWrap.appendChild(inner);

    el.appendChild(main); el.appendChild(exWrap);
