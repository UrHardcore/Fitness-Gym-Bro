          if(!day.exercises.includes(ex)) day.exercises.push(ex);
        } else {
          day.exercises = day.exercises.filter(i => i !== ex);
        }
      });

      item.appendChild(chk);
      item.appendChild(document.createTextNode(ex));
      list.appendChild(item);
