  function toggleDay(id){
    dayState[id] = !dayState[id];
    if(dayState[id]) { 
      streak++; 
      triggerConfetti(); 
      playRonnieColemanAudio();
    } else { 
      streak = Math.max(0, streak - 1); 
    }
    saveStreak(); saveWeekState(); render();
  }

  function toggleExercise(dayId, exName){
    if(!exState[dayId]) exState[dayId] = {};
    if(!exState[dayId][exName]) exState[dayId][exName] = { checked: false, sets: [{ kg: '', reps: '' }] };
    
    exState[dayId][exName].checked = !exState[dayId][exName].checked;
    
    const allEx = fullExercises(BASE_DAYS.find(b => b.id === dayId));
    if(allEx.length > 0 && allEx.every(e => exState[dayId][e] && exState[dayId][e].checked) && !dayState[dayId]) {
      dayState[dayId] = true; streak++; saveStreak(); triggerConfetti(); playRonnieColemanAudio();
    }
    saveWeekState(); render();
  }

  function addExercise(dayId, exName){
    if(!extra[dayId]) extra[dayId] = [];
    if(!extra[dayId].includes(exName)){ extra[dayId].push(exName); saveExtra(); }
    render();
  }

  function removeExercise(dayId, exName){
    if(extra[dayId]){ extra[dayId] = extra[dayId].filter(e => e !== exName); saveExtra(); }
    render();
  }

